{
	"schemaVersion": 1,
	"id": "shulkerinsight",
	"version": "${version}",
	"name": "Shulker Insight",
	"description": "Просмотр содержимого шалкеров в подсказках, отображение уровня заполнения и отметка шалкеров, содержащих предметы только одного типа.",
	"authors": [
		"AmadoMuerte"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/AmadoMuerte/ShulkerInsight"
	},
	"license": "CC-BY-4.0",
	"icon": "assets/shulkerinsight/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.shulkerinsight.ShulkerInsightClient"
		]
	},
	"mixins": [
		{
			"config": "shulkerinsight.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": ">=26.2",
		"java": ">=25",
		"fabric-api": "*"
